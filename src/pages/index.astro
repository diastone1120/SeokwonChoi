---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('projects')).sort((a, b) =>
  a.data.sheet.localeCompare(b.data.sheet)
);
const research = all.filter((p) => p.data.category === 'research');
const design = all.filter((p) => p.data.category === 'design');
const field = all.filter((p) => p.data.category === 'field');

const sections = [
  { label: 'Research', id: 'research', items: research },
  { label: 'Design', id: 'design', items: design },
  { label: 'Field & Workshop', id: 'field', items: field },
];
---
<BaseLayout description="Computational design & digital fabrication portfolio — sustainable material systems from bio-based earth composites to robotic construction.">
  <section class="hero">
    <span class="coord-corner tl">SHEET / 00</span>
    <span class="tick tl"></span>
    <span class="tick br"></span>
    <div class="eyebrow">Digital fabrication · Sustainable material systems</div>
    <h1>Low-carbon material systems, fabricated with <em>robotic precision</em>.</h1>
    <p class="sub">From bio-based earth and algae composites to UHPC and shape-memory polymers — researched through 3D printing, robotic tooling, and years of hands-on construction supervision.</p>
    <span class="coord-corner br">X 0 — Y 0<br>ORIGIN</span>
  </section>

  <div id="work">
  {sections.map((section) => section.items.length > 0 && (
    <>
      <div class="section-label" id={section.id}>{section.label}</div>
      <div class="work-grid">
        {section.items.map((project) => (
          <a class="sheet" href={`/work/${project.id}/`}>
            {project.data.image && (
              <div class="sheet-bg"><img src={project.data.image} alt="" /></div>
            )}
            <div class="idx">{project.data.sheet} <span class="card-year">{project.data.year}</span></div>
            <h3>{project.data.title}</h3>
            <p>{project.data.summary}</p>
            <div class="tags">
              {project.data.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </>
  ))}
  </div>

  <section class="about" id="about">
    <div class="label">About</div>
    <div>
      <p>A researcher and designer working at the intersection of sustainable material systems, computational design, and digital fabrication.</p>
      <p>MSc at the TAD (Transdisciplinary Architectural Design) Lab, University of Seoul, following a Bachelor of Architecture from the same institution. Background includes an internship at Heerim Architects &amp; Planners (2018) and three years as a construction supervisor (Lieutenant, Defense Installations Agency). Currently a student at ITECH (Integrative Technologies &amp; Architectural Design Research), University of Stuttgart.</p>
    </div>
  </section>
</BaseLayout>

---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string; // public/ 기준 상대 경로, 예: "/images/01-lattice-photo.jpg"
}
const {
  title = 'Seokwon Choi — Sustainable Material Systems & Digital Fabrication',
  description = 'Portfolio of Seokwon Choi — sustainable, low-carbon material research and robotic digital fabrication, spanning bio-based earth composites, algae bioplastics, and shape-memory polymers.',
  image = '/images/01-lattice-photo.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <ClientRouter />
</head>
<body>
  <header class="titlebar">
    <a class="mark" href="/">Seokwon Choi</a>
    <nav>
      <a href="/#work">Work</a>
      <a href="/tags/">Tags</a>
      <a href="/publications/">Publications</a>
      <a href="/#about">About</a>
      <a href="/#contact">Contact</a>
    </nav>
  </header>

  <slot />

  <div class="lightbox" id="lightbox">
    <span class="lightbox-close">CLOSE &#10005;</span>
    <img id="lightbox-img" src="" alt="" />
  </div>

  <script>
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const img = target.closest('.gallery-grid img') as HTMLImageElement | null;
      if (img) {
        const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
        const lightbox = document.getElementById('lightbox') as HTMLElement;
        lightboxImg.src = img.dataset.full || img.src;
        lightbox.classList.add('open');
        return;
      }

      const tabBtn = target.closest('.subtab-btn') as HTMLElement | null;
      if (tabBtn) {
        const group = tabBtn.closest('.subtabs') as HTMLElement;
        group.querySelectorAll('.subtab-btn').forEach((b) => b.classList.remove('active'));
        tabBtn.classList.add('active');
        const body = tabBtn.closest('.spec-body') as HTMLElement;
        const tab = tabBtn.dataset.tab;
        body.querySelectorAll('.subtab-panel').forEach((p) => p.classList.remove('active'));
        body.querySelector(`[data-panel="${tab}"]`)?.classList.add('active');
        return;
      }

      if (target.closest('#lightbox')) {
        document.getElementById('lightbox')?.classList.remove('open');
      }
    });
  </script>

  <footer id="contact">
    <span>© 2026 Seokwon Choi — All rights reserved</span>
    <span><a href="mailto:csw951120@gmail.com">csw951120@gmail.com</a> · <a href="https://www.linkedin.com/in/seokwon-choi-7b2a24289" target="_blank" rel="noopener">LinkedIn ↗</a></span>
  </footer>
</body>
</html>
